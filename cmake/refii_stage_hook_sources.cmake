# Stages the hook SOURCES for the install-time payload build.
#
# THE HOOKS CANNOT SHIP AS AN ARCHIVE. They are strong PPC overrides linked INTO the payload,
# and the payload is compiled on the player's machine by Zig. A librefii_hooks.a built here
# is built by our compiler: on Windows that is MSVC, whose C++ objects reference CRT
# internals a MinGW-built payload does not have, so the link cannot succeed no matter how
# few symbols cross. Shipping the sources and compiling them beside the generated code makes
# the whole payload one compiler's output.
#
# These are OUR sources, not game-derived, so shipping them is unrestricted — unlike the
# recompiled code they link against.
#
# Emits hook_sources.cmake (a title's hooks) and payload_core_sources.cmake (the payload's
# shared sources) in the same `set(VAR ...)` form the generator uses for sources.cmake, so the
# launcher reads all of them with one parser.

include_guard(GLOBAL)

# Copies `sources` under `destination`/`subdir`, by their path relative to `source_root`/src, and
# writes `destination`/`list_file` as `set(<variable> ...)`.
#
# A HEADER LISTED AMONG THE TARGET'S SOURCES IS STAGED TOO, beside them, and left out of the
# list: the player's build compiles the staged copies, so a header a hook includes by its own
# name (`#include "gui_statements.h"`) exists there only if it is shipped. Fable 3's hooks
# shipped without theirs and the launcher's build failed on the player's machine with a header
# the dev build had always found in the tree. The build-time gate
# (refii_check_staged_includes.cmake) now fails the export on any such include.
#
# A SOURCE THE TARGET DOES NOT COMPILE (HEADER_FILE_ONLY, passed after `variable`) is staged and
# left out of the list the same way: a .c another unit includes by path (the front end's Lua,
# Fable2/src/hooks/CMakeLists.txt) must reach the player's build without being compiled twice.
function(_refii_stage_source_list sources destination subdir source_root list_file variable)
    set(_stage_only ${ARGN})
    file(REMOVE_RECURSE "${destination}/${subdir}")
    set(_staged "")

    foreach(_source IN LISTS sources)
        if(NOT IS_ABSOLUTE "${_source}")
            continue()
        endif()
        if(_source MATCHES "\\.(h|hh|hpp|inl)$" OR _source IN_LIST _stage_only)
            set(_compiled FALSE)
        elseif(_source MATCHES "\\.(cpp|cc|c)$")
            set(_compiled TRUE)
        else()
            continue()
        endif()
        if(NOT EXISTS "${_source}")
            continue()
        endif()

        # Laid out under <subdir>/ by their path relative to src/, so a #include of a sibling
        # by relative path still resolves after staging.
        file(RELATIVE_PATH _relative "${source_root}/src" "${_source}")
        if(_relative MATCHES "^\\.\\.")
            get_filename_component(_relative "${_source}" NAME)
        endif()

        configure_file("${_source}" "${destination}/${subdir}/${_relative}" COPYONLY)
        if(_compiled)
            list(APPEND _staged "\${CMAKE_CURRENT_LIST_DIR}/${subdir}/${_relative}")
        endif()
    endforeach()

    list(LENGTH _staged _count)
    if(_count EQUAL 0)
        return()
    endif()

    list(JOIN _staged "\n    " _body)
    file(WRITE "${destination}/${list_file}"
         "# Generated by refii_stage_hook_sources.cmake - DO NOT EDIT\nset(${variable}\n    ${_body}\n)\n")

    message(STATUS "Staged ${_count} ${subdir} sources for the install-time payload build")
endfunction()

# A title's hooks: `target`'s sources, laid out relative to the title's src/ (`source_root`),
# listed as REFII_HOOK_SOURCES in hook_sources.cmake.
function(refii_stage_hook_sources target destination source_root)
    if(NOT TARGET "${target}")
        return()
    endif()

    get_target_property(_sources "${target}" SOURCES)
    if(NOT _sources)
        return()
    endif()

    set(_stage_only "")
    foreach(_source IN LISTS _sources)
        if(IS_ABSOLUTE "${_source}" AND _source MATCHES "\\.(cpp|cc|c)$")
            get_source_file_property(_header_only "${_source}" TARGET_DIRECTORY "${target}" HEADER_FILE_ONLY)
            if(_header_only)
                list(APPEND _stage_only "${_source}")
            endif()
        endif()
    endforeach()

    _refii_stage_source_list("${_sources}" "${destination}" hooks "${source_root}"
                             hook_sources.cmake REFII_HOOK_SOURCES ${_stage_only})
endfunction()

# The payload's shared sources (src/payload/src/core, REFII_PAYLOAD_CORE_SOURCES), compiled into
# every title's module whether or not it has hooks: listed as REFII_PAYLOAD_CORE_SOURCES in
# payload_core_sources.cmake, staged under payload_core/.
function(refii_stage_payload_core_sources destination)
    if(NOT REFII_PAYLOAD_CORE_SOURCES)
        return()
    endif()

    _refii_stage_source_list("${REFII_PAYLOAD_CORE_SOURCES}" "${destination}" payload_core
                             "${CMAKE_SOURCE_DIR}/src/payload" payload_core_sources.cmake
                             REFII_PAYLOAD_CORE_SOURCES)
endfunction()
